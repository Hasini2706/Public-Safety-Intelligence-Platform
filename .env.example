# ========================================================
# Public Safety, Physical Security & Governance Platform
# Root Environment Variables Template
# Copy to .env (do NOT commit .env to version control)
# ========================================================

# General Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (Future Integration - not required for base app)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
