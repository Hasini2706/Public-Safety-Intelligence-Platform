# -----------------------------
# ML Models, Weights & Datasets
# -----------------------------
# Rule: Do not commit large binary weights or local raw datasets.
*.joblib
*.pkl
*.pickle
*.h5
*.keras
*.onnx
*.pt
*.pth
*.bin
*.weights
*.ckpt
*.safetensors

# Model directories (binary checkpoints & exports)
ml/*/models/
ml/*/checkpoints/
ml/models/
checkpoints/

# Raw and processed datasets (keep documentation & .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.sqlite
*.db
!tests/fixtures/*.csv

