# ========================================================
# Backend Environment Configuration
# Copy to backend/.env (Do NOT commit real credentials)
# ========================================================

APP_ENV=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="Public Safety Intelligence Platform API"
DEBUG=true

# Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS (Comma separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Future Database / Supabase integration (optional in base app)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
